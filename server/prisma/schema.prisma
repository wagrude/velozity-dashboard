generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  STATUS_CHANGED
  TASK_ASSIGNED
  PROJECT_CREATED
  TASK_OVERDUE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_IN_REVIEW
}

model User {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  passwordHash String
  role         Role

  projects      Project[]
  tasks         Task[]
  activities    ActivityLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  pmId       Int
  pm         User     @relation(fields: [pmId], references: [id])

  tasks      Task[]
  activities ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pmId])
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?

  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  developerId Int?
  developer   User?        @relation(fields: [developerId], references: [id], onDelete: SetNull)

  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  isOverdue   Boolean      @default(false)

  activities ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([developerId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isOverdue])
}

model ActivityLog {
  id        Int          @id @default(autoincrement())
  type      ActivityType
  message   String

  taskId    Int?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    Int
  user      User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)

  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}